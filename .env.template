# 派生为 .env.dev / .env.prod；账号和凭据分别填写。
# 生产环境设置 DEBUG=false，并省略 Development 分区。

# ======================== Runtime ========================
HOST=127.0.0.1
PORT=16777
DEBUG=true
# LOG_LEVEL=INFO
# HTTP_PROXY=

# ========================== Bot ==========================
SUPERUSERS=[]
IGNORED_USERS=[]
MAIN_GROUP_ID=
NICKNAME=["千凛", "樱井千凛", "凛凛", "Senrin", "凛酱", "凛凛子", "rin", "Rin"]
COMMAND_START=["#","＃","井"]
# HELP_SUPPORT_GROUPS='[{"title":"","group_id":"","url":""}]'

# ====================== Development ======================
# DEV_TEST_* 仅在 DEBUG=true 时生效。
DEV_TEST_GROUPS=[]
DEV_TEST_USERS=[]
# DEBUG_SQL_ECHO=false

# ===================== Notifications =====================
# ADMIN_NOTIFY_PRIVATE_ENABLED=true
# ADMIN_NOTIFY_GROUP_ENABLED=false
# ADMIN_NOTIFY_GROUP_IDS=[]

# ======================== Storage ========================
WORDBANK_MEDIA_PROVIDER=local

# GitHub：三个字段暂需保留；不用时 token/repo 留空。
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# R2：R2_ENDPOINT 留空时按 R2_ACCOUNT_ID 生成。
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
# R2_ENDPOINT=

# 帮助图片：本机 scripts/docs_assets.py publish 发布到当前 R2；bot.py 启动自动同步。
# 各环境使用不同 bucket 时，须分别发布同一构建产物。

# ======================== Backup =========================
# 只填写当前环境的一组仓库和密码；启用前需安装 restic。
BACKUP_ENABLED=false
BACKUP_RESTIC_REPOSITORY=
BACKUP_RESTIC_PASSWORD=
# S3 凭据复用 R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY。
# BACKUP_CRON_HOUR=3
# BACKUP_CRON_MINUTE=20
# BACKUP_LOCAL_ROOT=./data/backup
# BACKUP_REQUIRE_RESTIC=true
# BACKUP_RETENTION_DAILY=7
# BACKUP_RETENTION_WEEKLY=4
# BACKUP_RETENTION_MONTHLY=6

