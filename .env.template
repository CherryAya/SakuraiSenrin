# 管理通知投递配置
# ADMIN_NOTIFY_PRIVATE_ENABLED=true 时，会给每个 SUPERUSER 发一份私聊通知
# ADMIN_NOTIFY_GROUP_ENABLED=true 时，会额外向 ADMIN_NOTIFY_GROUP_IDS 中的群广播一份通知
# ADMIN_NOTIFY_GROUP_IDS 使用和 SUPERUSERS 一样的数组语法；会自动去重
ADMIN_NOTIFY_PRIVATE_ENABLED=true
ADMIN_NOTIFY_GROUP_ENABLED=false
ADMIN_NOTIFY_GROUP_IDS=[]

# 管理通知 demo 配置
# 仅管理员私聊:
# ADMIN_NOTIFY_PRIVATE_ENABLED=true
# ADMIN_NOTIFY_GROUP_ENABLED=false
# ADMIN_NOTIFY_GROUP_IDS=[]
#
# 管理员私聊 + 2 个通知群:
# ADMIN_NOTIFY_PRIVATE_ENABLED=true
# ADMIN_NOTIFY_GROUP_ENABLED=true
# ADMIN_NOTIFY_GROUP_IDS=["1107576103","729530250"]


# GitHub 图床相关配置
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_REPO=user/repo_name
GITHUB_BRANCH=master

# 对象存储通用配置
# 可选值: r2 / github；未配置时由具体能力自行降级
OBJECT_STORAGE_DEFAULT_PROVIDER=

# Cloudflare R2 配置
# R2_ENDPOINT 可留空，留空时会根据 R2_ACCOUNT_ID 自动生成
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=

# wordbank 媒体存储 provider
# 可选值: local / r2 / github
WORDBANK_MEDIA_PROVIDER=local

# 数据库备份配置
# 启用后 bot 启动时会注册定时备份任务
APP_ENV=development
BACKUP_ENABLED=false
BACKUP_CRON_HOUR=3
BACKUP_CRON_MINUTE=20
BACKUP_LOCAL_ROOT=./data/backup

# 默认 profile 可显式指定 prod / dev；留空时会按 APP_ENV 自动映射
BACKUP_REMOTE_PROFILE=

# restic 仓库配置（兼容旧版单仓库）
# R2 示例:
# BACKUP_RESTIC_REPOSITORY=s3:https://<account_id>.r2.cloudflarestorage.com/<bucket>/sakurai-senrin
BACKUP_RESTIC_REPOSITORY=
BACKUP_RESTIC_PASSWORD=

# 生产 / 开发双仓库配置（推荐）
# prod 只允许 production 写入；dev 只允许 development 写入
BACKUP_PROD_RESTIC_REPOSITORY=
BACKUP_PROD_RESTIC_PASSWORD=
BACKUP_DEV_RESTIC_REPOSITORY=
BACKUP_DEV_RESTIC_PASSWORD=
BACKUP_REQUIRE_RESTIC=true

# restic 保留策略
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6

SAUCENAO_KEY=
ASCII2D_KEY=
SENTRY_DSN=

# 网络代理，默认不使用
HTTP_PROXY=
