# 全仓默认：按内容自动判定文本，文本文件检出为 LF
* text=auto eol=lf

# 二进制资源：显式排除，禁止任何行尾转换（否则 webp/png 会被当文本改写而损坏）
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

*.ttf filter=lfs diff=lfs merge=lfs -text
*.db filter=lfs diff=lfs merge=lfs -text
data/db/** -filter -diff -merge text
data/**/*.db -filter -diff -merge text
data/**/*.zst -filter -diff -merge text
.devtest/**/*.db -filter -diff -merge text
.devtest/**/*.zst -filter -diff -merge text
